# Copy this file to .env for local development (and add .env to .gitignore).
# In production (Render/Railway/etc.), set these as actual environment variables
# in your host's dashboard — never commit real secrets to git.

# --- Gemini ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# --- WhatsApp Cloud API (from Meta App Dashboard > WhatsApp > API Setup) ---
WHATSAPP_TOKEN=your_whatsapp_cloud_api_token
PHONE_NUMBER_ID=your_phone_number_id
APP_SECRET=your_meta_app_secret
VERIFY_TOKEN=choose_any_random_string_yourself

# --- Firebase (paste the FULL content of your service-account JSON as one line) ---
FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key":"..."}

# --- Real estate agent settings ---
AGENCY_NAME=Your Agency Name

# --- Google Calendar (for auto site-visit booking) ---
GOOGLE_CALENDAR_ID=your_calendar_id@group.calendar.google.com
CALENDAR_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key":"..."}

# --- Dashboard login (required to protect /) ---
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=choose_a_strong_password

# --- Misc ---
PORT=10000
